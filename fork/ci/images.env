# Images the acceptance scripts pull from ECR Public, each pinned by the digest of its index.
# ECR Public answers anonymous pulls from the shared addresses of GitHub's runners with
# "Data limit exceeded", so CI copies each one to GHCR once (mirror-image.sh) and pulls the
# copy; a run outside CI pulls these as written. Read by fork/kubernetes/run.sh,
# fork/eks-provisioner/e2e.sh and .github/workflows/fork-acceptance.yml.
AWS_CLI_PIN=public.ecr.aws/aws-cli/aws-cli:2.37.8@sha256:420ab345e847291b541b45d989535f55bcff957c27fa1100fae4aa233e86398c
# The tag is the chart version fork/kubernetes/run.sh installs (LBC_CHART_VERSION).
LBC_PIN=public.ecr.aws/eks/aws-load-balancer-controller:v3.6.3@sha256:bc9bee8bc5b2b9f69fe914c06ed3ddb24ce9c94e234cf101dff1ec04693a6974
